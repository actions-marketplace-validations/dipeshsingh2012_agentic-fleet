+    async def _sync_status_to_aroadmap(
+        self,
+        initiative_id: str,
+        stage: str,
+        pipeline_status: str,
+        stages_summary: Dict[str, Any],
+    ) -> None:
+        """
+        Return-sync: report fleet pipeline status back to aroadmap.dev MCP server.
+        Called after pipeline completion or halt to keep aroadmap board in sync.
+        """
+        aroadmap_url = os.environ.get("AROADMAP_MCP_URL", "https://aroadmap.dev/api/mcp")
+        payload = {
+            "jsonrpc": "2.0",
+            "id": 1,
+            "method": "tools/call",
+            "params": {
+                "name": "transition_initiative_stage",
+                "arguments": {
+                    "item_id": initiative_id,
+                    "stage": stage,
+                    "feedback": f"Fleet pipeline status: {pipeline_status}",
+                },
+            },
+        }
+        try:
+            import httpx
+
+            async with httpx.AsyncClient(timeout=15.0) as client:
+                resp = await client.post(aroadmap_url, json=payload)
+                if resp.status_code < 300:
+                    print(f"[RETURN-SYNC] ✅ Synced status '{pipeline_status}' -> stage '{stage}' to aroadmap for initiative '{initiative_id}'")
+                else:
+                    print(f"[RETURN-SYNC] ⚠️ aroadmap sync returned HTTP {resp.status_code}: {resp.text[:200]}")
+        except Exception as exc:
+            print(f"[RETURN-SYNC] ⚠️ Failed syncing to aroadmap: {exc}")
